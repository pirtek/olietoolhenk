<!DOCTYPE html>
<html lang="nl"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Olie-analyse rapport generator</title>
<style>
:root{--bg:#fff;--fg:#1b1f24;--mut:#5b6570;--card:#f4f6f9;--bd:#d5dbe3;--pri:#003087;--onpri:#fff;--bad:#c00000;color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#14181d;--fg:#e8ecf1;--mut:#9aa5b1;--card:#1e242b;--bd:#343d47;--pri:#6c9bff;--onpri:#0b1220;--bad:#ff7b7b;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#14181d;--fg:#e8ecf1;--mut:#9aa5b1;--card:#1e242b;--bd:#343d47;--pri:#6c9bff;--onpri:#0b1220;--bad:#ff7b7b;color-scheme:dark}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;background:var(--bg);color:var(--fg);font:15px/1.5 system-ui,-apple-system,"Segoe UI",Arial,sans-serif}
main{max-width:920px;margin:0 auto;padding:20px 16px 60px}
h1{font-size:22px;margin:0 0 4px}h2{font-size:16px;margin:26px 0 8px}
p.s{color:var(--mut);margin:0 0 16px}
.card{background:var(--card);border:1px solid var(--bd);border-radius:10px;padding:14px}
.drop{border:2px dashed var(--bd);text-align:center;padding:26px 12px;cursor:pointer;border-radius:10px}
.drop:hover{border-color:var(--pri)}
button{background:var(--pri);color:var(--onpri);border:0;border-radius:8px;padding:10px 16px;font:inherit;font-weight:600;cursor:pointer}
button.g{background:transparent;color:var(--pri);border:1px solid var(--bd);padding:5px 10px;font-weight:500}
button:disabled{opacity:.5;cursor:default}
input,textarea,select{font:inherit;color:var(--fg);background:var(--bg);border:1px solid var(--bd);border-radius:6px;padding:6px 8px;width:100%;box-sizing:border-box}
textarea{min-height:90px;resize:vertical}
label{display:block;font-size:12px;color:var(--mut);margin-bottom:2px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:10px}
.wrap{overflow-x:auto}table{border-collapse:collapse;width:100%;min-width:640px}td{padding:3px}
#st{margin:10px 0;color:var(--mut)}#st.e{color:var(--bad)}
</style></head><body><main>
<h1>Olie-analyse rapport generator</h1>
<p class="s">Upload het PDF-rapport van het laboratorium. Claude leest de testresultaten uit en schrijft de analyse; het resultaat wordt opgemaakt in de Pirtek Word-stijl (Oil Analysis Report). Het rapport blijft in het Engels, zoals je voorbeeld.</p>
<div class="drop" id="drop">Klik of sleep hier het PDF-bestand met testresultaten<input type="file" id="f" accept="application/pdf" hidden></div>
<div id="st"></div>
<div id="form" hidden></div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js"></script>
<script>
window.TPL="";
const $=s=>document.querySelector(s),st=$('#st');
const say=(t,e)=>{st.textContent=t;st.className=e?'e':''};
const MONTHS=['January','February','March','April','May','June','July','August','September','October','November','December'];
const today=new Date();
const todayTxt=`${today.getDate()} ${MONTHS[today.getMonth()]} ${today.getFullYear()}`;
let S=null,rawText='';
const LV={ok:{color:'000000',bold:false},attention:{color:'B26B00',bold:true},bad:{color:'C00000',bold:true}};
const OV={Normal:'2E7D32',Caution:'B26B00',Action:'B26B00',Critical:'C00000'};

$('#drop').onclick=()=>$('#f').click();
$('#drop').ondragover=e=>e.preventDefault();
$('#drop').ondrop=e=>{e.preventDefault();run(e.dataTransfer.files[0])};
$('#f').onchange=e=>run(e.target.files[0]);

async function pdfText(file){
  pdfjsLib.GlobalWorkerOptions.workerSrc='https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
  const pdf=await pdfjsLib.getDocument({data:await file.arrayBuffer(),isEvalSupported:false}).promise;
  let out='';
  for(let i=1;i<=pdf.numPages;i++){
    const items=(await(await pdf.getPage(i)).getTextContent()).items.filter(x=>x.str.trim());
    const lines=[];
    items.forEach(it=>{const y=Math.round(it.transform[5]);let l=lines.find(l=>Math.abs(l.y-y)<=3);if(!l){l={y,a:[]};lines.push(l)}l.a.push([it.transform[4],it.str])});
    lines.sort((a,b)=>b.y-a.y).forEach(l=>{out+=l.a.sort((a,b)=>a[0]-b[0]).map(x=>x[1]).join('  ')+'\n'});
    out+='\n';
  }
  return out;
}

const PROMPT=`You convert a laboratory oil-analysis PDF (text below) into data for a Pirtek "Oil Analysis Report". Write in English, in a calm, factual, practical tone from the perspective of Pirtek, a hydraulic hose and fluid service company.
Rules: use ONLY values present in the PDF text; never invent numbers; use "" for unknown text fields (client: "[insert client name]"). Dates like "8 July 2026"; sampleISO as YYYY-MM-DD. overall must be one of Normal, Caution, Action, Critical (take the laboratory's own rating if given).
params: in this order where present: Viscosity at 40 degrees (mm2/s), Viscosity at 100 degrees, Water content, Conductivity, Total Acid Number, MPC (varnish index), ISO 4406, Iron, Chromium, Aluminium, Copper, Silicon, Zinc / phosphorus (additive), Glycol (screening), Oxidation; add other measured values if relevant. Each has name, value (string), unit, assessment (short, may be empty) and level (ok|attention|bad). Reference points: ISO 4406 general industrial hydraulics 20/18/15 or cleaner, servo/proportional 18/16/13; MPC below 15 normal; conductivity below 500 pS/m is a point of attention; ISO VG band is nominal plus/minus 10 percent (VG46 41.4-50.6, VG68 61.2-74.8, VG32 28.8-35.2, VG100 90-110); compare viscosity and additives with the fluid on record.
particles: list of {size, count} in micrometres (e.g. "4", "3,669") for each particle size the PDF reports.
summary: 2-3 short paragraphs (what was sampled and when, overall condition, main point of attention, tone reassuring but honest). labAssessment: bullets paraphrasing the laboratory's own findings/recommendations; patchNote: one sentence about the patch test if present else "". pirtek: 3-5 paragraphs interpreting the data (distribution of coarse particles, additives, viscosity, glycol/water, trends to monitor), with a concrete recommendation. actions: 3-6 short action steps in priority order.
Return JSON only: {client,asset,assetRef,fluid,site,sampleDate,sampleISO,sampleNumber,labDate,laboratory,overall,samplingBy,params:[],particles:[],summary:[],labAssessment:[],patchNote,pirtek:[],actions:[]}
PDF TEXT:
`;

async function run(file){
  if(!file)return;
  S={client:'[insert client name]',asset:'',assetRef:'',fluid:'',site:'',sampleDate:'',sampleISO:'',sampleNumber:'',labDate:'',laboratory:'',overall:'Normal',samplingBy:'Pirtek Rotterdam-Noord',params:[],particles:[],summary:[],labAssessment:[],patchNote:'',pirtek:[],actions:[]};
  try{
    say('PDF wordt gelezen…');
    rawText=await pdfText(file);
    if(rawText.trim().length<40) throw new Error('Geen tekst gevonden in de PDF (gescand?). Gebruik een PDF met selecteerbare tekst.');
    const sample=await claude.use('sample');
    if(!sample){say('De Claude-koppeling is hier niet beschikbaar. Vul het formulier handmatig in.',1);render();return}
    say('Claude leest de resultaten en schrijft de analyse… (even geduld)');
    const d=await sample.json(PROMPT+rawText.slice(0,60000),{modelTier:'complex',cache:false});
    S=Object.assign(S,d);S.reportDate=todayTxt;
    say('Klaar: controleer hieronder de gegevens en pas aan waar nodig.');render();
  }catch(e){say('Fout: '+(e.message||e.code||e),1);render()}
}

const META=[['client','Client'],['asset','Asset'],['assetRef','Asset reference'],['fluid','Fluid on record'],['site','Site'],['sampleDate','Sample date'],['sampleNumber','Sample number'],['labDate','Laboratory analysis date'],['laboratory','Laboratory'],['samplingBy','Sampling by'],['reportDate','Report date']];
const LISTS=[['summary','1 Summary (één alinea per regel)'],['labAssessment','2 Laboratory assessment (één opsommingspunt per regel)'],['pirtek','4 Pirtek assessment (één alinea per regel)'],['actions','5 Recommended actions (één actie per regel)']];
const esc=s=>String(s??'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));
function render(){
  S.reportDate=S.reportDate||todayTxt;
  const f=$('#form');f.hidden=false;
  f.innerHTML=`<h2>Gegevens</h2><div class="card grid">${META.map(([k,l])=>`<div><label>${l}</label><input data-k="${k}" value="${esc(S[k])}"></div>`).join('')}
  <div><label>Overall fluid condition</label><select data-k="overall">${Object.keys(OV).map(o=>`<option ${S.overall===o?'selected':''}>${o}</option>`).join('')}</select></div></div>
  <h2>3 Test results</h2><div class="card wrap"><table><tr><td><label>Parameter</label></td><td><label>Value</label></td><td><label>Unit</label></td><td><label>Assessment</label></td><td><label>Niveau</label></td><td></td></tr>
  ${S.params.map((p,i)=>`<tr>${['name','value','unit','assessment'].map(k=>`<td><input data-p="${i}" data-f="${k}" value="${esc(p[k])}"></td>`).join('')}<td><select data-p="${i}" data-f="level">${['ok','attention','bad'].map(l=>`<option ${p.level===l?'selected':''}>${l}</option>`).join('')}</select></td><td><button class="g" data-del="p${i}">×</button></td></tr>`).join('')}</table>
  <button class="g" data-add="p">+ parameter</button></div>
  <h2>Particle distribution</h2><div class="card wrap"><table><tr><td><label>Larger than (µm)</label></td><td><label>Count per millilitre</label></td><td></td></tr>
  ${S.particles.map((p,i)=>`<tr><td><input data-q="${i}" data-f="size" value="${esc(p.size)}"></td><td><input data-q="${i}" data-f="count" value="${esc(p.count)}"></td><td><button class="g" data-del="q${i}">×</button></td></tr>`).join('')}</table>
  <button class="g" data-add="q">+ rij</button></div>
  ${LISTS.map(([k,l])=>`<h2>${l}</h2><textarea data-l="${k}">${esc(S[k].join('\n'))}</textarea>`).join('')}
  <h2>Patch test (één zin, optioneel)</h2><input data-k="patchNote" value="${esc(S.patchNote)}">
  <p style="margin-top:22px"><button id="go">Download Word-rapport (.docx)</button></p>
  <details><summary>Uitgelezen PDF-tekst</summary><pre style="white-space:pre-wrap;font-size:12px">${esc(rawText)}</pre></details>`;
  f.oninput=e=>{const d=e.target.dataset;
    if(d.k)S[d.k]=e.target.value;
    else if(d.p!==undefined)S.params[d.p][d.f]=e.target.value;
    else if(d.q!==undefined)S.particles[d.q][d.f]=e.target.value;
    else if(d.l)S[d.l]=e.target.value.split('\n').map(x=>x.trim()).filter(Boolean)};
  f.onclick=e=>{const d=e.target.dataset;
    if(d.del){const i=+d.del.slice(1);(d.del[0]==='p'?S.params:S.particles).splice(i,1);render()}
    if(d.add){(d.add==='p'?S.params:S.particles).push(d.add==='p'?{name:'',value:'',unit:'',assessment:'',level:'ok'}:{size:'',count:''});render()}};
  $('#go').onclick=build;
}

/* ---- docx opbouw op basis van het sjabloon ---- */
const NS='http://schemas.openxmlformats.org/wordprocessingml/2006/main',W14='http://schemas.microsoft.com/office/word/2010/wordml';
const q=(e,t)=>[...e.getElementsByTagNameNS(NS,t)],kids=(e,t)=>[...e.children].filter(c=>c.localName===t);
const mk=(d,t)=>d.createElementNS(NS,'w:'+t);
function setP(p,text,o={}){
  const d=p.ownerDocument;let r=kids(p,'r')[0];
  if(!r){r=mk(d,'r');const rp=mk(d,'rPr'),c=mk(d,'color'),z=mk(d,'sz');c.setAttributeNS(NS,'w:val','000000');z.setAttributeNS(NS,'w:val','18');rp.append(c,z);r.append(rp);p.append(r)}
  [...p.children].forEach(c=>{if(c!==r&&c.localName!=='pPr')p.removeChild(c)});
  q(r,'lastRenderedPageBreak').forEach(x=>x.remove());
  const ts=q(r,'t');ts.slice(1).forEach(x=>x.remove());
  let t=ts[0];if(!t){t=mk(d,'t');r.append(t)}
  t.textContent=text;t.setAttributeNS('http://www.w3.org/XML/1998/namespace','xml:space','preserve');
  if(o.color||o.bold!==undefined){
    let rp=kids(r,'rPr')[0];if(!rp){rp=mk(d,'rPr');r.prepend(rp)}
    if(o.bold!==undefined){q(rp,'b').concat(q(rp,'bCs')).forEach(x=>x.remove());if(o.bold){const b=mk(d,'b'),bc=mk(d,'bCs');rp.prepend(bc);rp.prepend(b)}}
    if(o.color){let c=q(rp,'color')[0];if(!c){c=mk(d,'color');rp.append(c)}c.setAttributeNS(NS,'w:val',o.color)}
  }
}
const clean=n=>{[n,...n.querySelectorAll('*')].forEach(x=>{x.removeAttributeNS(W14,'paraId');x.removeAttributeNS(W14,'textId')});return n};
const cell=(tc,t,o)=>setP(q(tc,'p')[0],t,o);
function paras(tpls,texts){
  const par=tpls[0].parentNode,list=texts.length?texts:[''];
  list.forEach((t,i)=>{const c=clean(tpls[Math.min(i,tpls.length-1)].cloneNode(true));setP(c,t);par.insertBefore(c,tpls[0])});
  tpls.forEach(t=>par.removeChild(t));
}
function rows(tbl,fn,data){
  const rs=kids(tbl,'tr'),proto=rs[1];
  rs.slice(1).forEach(r=>tbl.removeChild(r));
  data.forEach((d,i)=>{const c=clean(proto.cloneNode(true));fn(kids(c,'tc'),d,i);tbl.appendChild(c)});
}
async function build(){
  try{
    const zip=await JSZip.loadAsync(window.TPL,{base64:true,createFolders:false});
    const doc=new DOMParser().parseFromString(await zip.file('word/document.xml').async('string'),'application/xml');
    const body=doc.getElementsByTagNameNS(NS,'body')[0],B=[...body.children];
    setP(q(B[1],'p')[0]||B[1],`Sample ${S.sampleNumber}  |  ${S.asset}`);
    const m=kids(B[3],'tr'),v=i=>kids(m[i],'tc')[1];
    [S.client,S.asset,S.assetRef,S.fluid,S.site,S.sampleDate,S.sampleNumber,S.labDate,S.laboratory].forEach((x,i)=>cell(v(i),x));
    cell(v(9),S.overall,{color:OV[S.overall],bold:true});cell(v(10),S.samplingBy);cell(v(11),S.reportDate);
    const ps=S.params.filter(p=>p.name);
    rows(B[17],(c,p)=>{cell(c[0],p.name);cell(c[1],p.value);cell(c[2],p.unit);cell(c[3],p.assessment||'',LV[p.level]||LV.ok)},ps);
    rows(B[20],(c,p)=>{cell(c[0],`Larger than ${p.size} micrometres`);cell(c[1],p.count)},S.particles.filter(p=>p.size));
    rows(B[32],(c,a,i)=>{cell(c[0],String(i+1));cell(c[1],a)},S.actions);
    paras([B[6],B[7]],S.summary);
    paras([B[12]],S.labAssessment);
    S.patchNote?setP(B[13],S.patchNote):body.removeChild(B[13]);
    paras([B[24],B[25]],S.pirtek);
    [8,26,27,28].forEach(i=>body.removeChild(B[i]));
    zip.file('word/document.xml',(x=>x.startsWith('<?xml')?x:'<?xml version="1.0" encoding="UTF-8" standalone="yes"?>\n'+x)(new XMLSerializer().serializeToString(doc)));
    const out=new JSZip();for(const [n,f] of Object.entries(zip.files))if(!f.dir)out.file(n,await f.async('uint8array'),{createFolders:false});
    const data=await out.generateAsync({type:'uint8array',compression:'DEFLATE'});
    const iso=(S.sampleISO||'').split('-').reverse().join('-')||'report';
    const name=`Oil_Analysis_Report_${(S.asset||'asset').replace(/[^\w]+/g,'-')}_${iso}_v1.docx`;
    const dl=await claude.use('downloads');
    if(!dl){say('Downloaden is hier niet beschikbaar.',1);return}
    await dl.save({filename:name,data:new Blob([data],{type:'application/vnd.openxmlformats-officedocument.wordprocessingml.document'})});
    say('Rapport gegenereerd: '+name);
  }catch(e){if(e&&e.code==='declined')return;say('Fout bij genereren: '+(e.message||e.code||e),1)}
}
</script></main></body></html>
